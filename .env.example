# Copie este arquivo para ".env" e preencha com os valores reais.

# Opcional, mas recomendado: se preenchido, a IA (Claude) interpreta os
# dados do processo e gera respostas humanizadas seguindo as regras do
# prompt mestre (system_prompt.py). Sem isso, o bot usa um modo
# fallback com templates determinísticos mais simples.
ANTHROPIC_API_KEY=

# Opcional: modelo Claude a usar. Se vazio, usa o padrão definido em
# ia_followup.py.
ANTHROPIC_MODEL=

# Opcional: caminho do arquivo SQLite de auditoria/painel (padrão: ./atendimentos.db)
DB_PATH=

# Token que você escolhe para a Meta validar seu webhook (qualquer string).
WHATSAPP_VERIFY_TOKEN=seletocomex-dev-token

# Preencher quando for conectar à API real do WhatsApp Business (Meta Cloud API):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Fonte de dados dos processos de importação:
#   "mock"             -> dados fictícios para teste (padrão)
#   "conexos_planilha" -> planilha real exportada do CONEXOS, enviada via
#                         POST /admin/upload-conexos (ver conexos_planilha.py)
#   "conexos"          -> API oficial do CONEXOS, quando existir
#                         (conexos_connector.py, ainda não implementado)
ERP_BACKEND=mock

# Preencher quando o CONEXOS liberar acesso de integração via API:
CONEXOS_API_BASE_URL=
CONEXOS_API_KEY=

# Caminho onde o arquivo enviado por /admin/upload-conexos fica salvo no
# servidor (usado quando ERP_BACKEND=conexos_planilha).
CONEXOS_EXPORT_PATH=dados_conexos.xlsx

# Senha da página de upload manual da planilha (/admin/upload). Escolha
# qualquer string aleatória — é o que protege esse upload de qualquer
# pessoa que descobrir a URL.
UPLOAD_SECRET=

# Chave secreta que protege o endpoint POST /cron/followup-semanal —
# escolha qualquer string aleatória. O agendador externo (GitHub
# Actions) precisa mandar esse mesmo valor no header X-Cron-Secret.
CRON_SECRET=

# Envio do resumo semanal por e-mail (opcional — sem isso, os rascunhos
# só ficam disponíveis no /painel). Caixa dedicada recomendada:
# followup@seletocomex.com.br, com SMTP AUTH habilitado (ver TI).
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
